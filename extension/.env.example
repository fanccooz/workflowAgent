# 扩展构建时注入的默认值（仅本机；勿提交真实 Key）
# 复制为 .env 后填写。用户仍可在「扩展选项」里覆盖并写入 chrome.storage。

VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_ENABLED=true

VITE_HABIT_ENABLED=true
VITE_HABIT_BACKEND_URL=http://localhost:3000
VITE_HABIT_EXTENSION_TOKEN=warom-dev-token
